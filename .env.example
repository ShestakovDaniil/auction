# Шаблон: реальные учетные данные и ключ храните только в .env.
# Скопируйте файл в .env и замените значения-заглушки либо выполните make setup.
APP_NAME=Auction Lab
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=mysql+pymysql://auction_app:REPLACE_WITH_PASSWORD@127.0.0.1:3306/auction_lab?charset=utf8mb4
# Отдельная база для автоматических тестов. Ее таблицы удаляются при проверках.
TEST_DATABASE_URL=mysql+pymysql://auction_app:REPLACE_WITH_PASSWORD@127.0.0.1:3306/auction_lab_test?charset=utf8mb4
APP_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
AUTO_CREATE_TABLES=false
ACCESS_TOKEN_EXPIRE_MINUTES=480
COOKIE_SECURE=false
MIN_BID_INCREMENT=1.00
CATALOG_PAGE_SIZE=9
ALLOWED_HOSTS=127.0.0.1,localhost
